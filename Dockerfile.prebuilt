FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
RUN groupadd --system --gid 1001 nodejs && useradd --system --uid 1001 --gid nodejs nextjs && mkdir -p /data/attachments && chown nextjs:nodejs /data/attachments
COPY --chown=nextjs:nodejs standalone/ ./
COPY --chown=nextjs:nodejs static/ ./.next/static
COPY --chown=nextjs:nodejs public/ ./public
COPY --chown=nextjs:nodejs drizzle/ ./drizzle
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
